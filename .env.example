# Copy this file to .env and fill in real values for local development.
# Never commit a .env file containing real secrets.

# --- Backend: general ---
ENVIRONMENT=development
# Comma-separated list of browser origins allowed to call the backend API.
CORS_ORIGINS=http://localhost:3000

# --- Backend: OpenAI (used by later PRs for vision/semantic analysis) ---
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_SEMANTIC_MODEL=

# --- Backend: Anthropic (used by a later PR for compatibility matching) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MATCHER_MODEL=

# --- Backend: Figma (used by a later PR for the Figma input path) ---
FIGMA_ACCESS_TOKEN=

# --- Backend: Qdrant (used by a later PR for Material UI retrieval) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=mui_component_docs

# --- Frontend ---
# Used by the Next.js server (Server Components, Route Handlers) for
# container-to-container requests. Inside Compose this resolves to the
# backend's service name; see PROJECT_SPEC.md section 7.
INTERNAL_API_URL=http://backend:8000
# Used by browser-side code. Must be reachable from the host machine.
NEXT_PUBLIC_API_URL=http://localhost:8000

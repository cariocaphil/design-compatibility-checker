# Next.js `output: "standalone"` file tracing has a known issue resolving
# @swc/helpers when pnpm nests it under a dependency-specific virtual store
# path (e.g. node_modules/.pnpm/next@.../node_modules/@swc/helpers). Hoisting
# it to the top-level node_modules avoids the broken trace.
public-hoist-pattern[]=*@swc/helpers*
